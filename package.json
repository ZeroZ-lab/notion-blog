{
  "name": "notion-blog",
  "version": "3.0.0",
  "private": true,
  "description": "A personal blog built with TanStack Start and MDX.",
  "author": "GuanMu <zerozzz.win>",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/generate-search-index.mjs && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "generate-search-index": "node scripts/generate-search-index.mjs",
    "test": "run-p test:*",
    "test:lint": "eslint .",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx}' --check"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-router": "^1.125.4",
    "@tanstack/react-start": "^1.125.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-pretty-code": "^0.14.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "@fisch0920/config": "^1.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router-devtools": "^1.125.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.35.0",
    "lint-staged": "^17.0.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.20.5"
  },
  "prettier": "@fisch0920/config/prettier",
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --ignore-unknown --write",
      "eslint --fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}